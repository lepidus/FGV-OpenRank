msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey"
msgstr "Chave de API do Altmetric"

msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey.description"
msgstr "Insira a chave de API do Altmetric (opcional). Caso não seja fornecida, a aba Trending usará a lista manual de DOIs definida abaixo. Requer 'api_key_secret' configurado em config.inc.php."

msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey.stored"
msgstr "Uma chave de API já está armazenada (criptografada). Deixe o campo em branco para mantê-la, ou preencha para substituí-la."

msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey.remove"
msgstr "Remover chave de API armazenada"

msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey.secretMissing"
msgstr "Não foi possível salvar a chave: o parâmetro 'api_key_secret' não está configurado em config.inc.php."

msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey.invalid"
msgstr "A chave de API do Altmetric foi rejeitada pela API. Verifique a chave e tente novamente."

