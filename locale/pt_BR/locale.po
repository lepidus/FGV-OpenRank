msgid "plugins.generic.fgvOpenRank.trendingDois.doiNotInJournal"
msgstr "Este DOI não foi encontrado na revista. Apenas DOIs atribuídos a submissões desta revista podem ser adicionados."

msgid "plugins.generic.fgvOpenRank.trendingDois.deleteConfirm"
msgstr "Tem certeza que deseja remover este DOI da lista?"

msgid "plugins.generic.fgvOpenRank.trendingDois.inactiveWhileApiKeySet"
