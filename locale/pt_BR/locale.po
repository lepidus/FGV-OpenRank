msgstr "Abrir o Conteúdo Adicional"

msgid "plugins.generic.fgvOpenRank.configurationGuide.link.masthead"
msgstr "Abrir a Equipe Editorial da revista"

msgid "plugins.generic.fgvOpenRank.configurationGuide.link.homepage"
msgstr "Abrir a página inicial da revista"
