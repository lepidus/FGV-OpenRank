msgid "plugins.generic.rankingPlugin.displayName"
msgstr "Ranking Plugin"

msgid "plugins.generic.rankingPlugin.description"
msgstr "Adds a ranking block with selectable metrics."

msgid "plugins.generic.rankingPlugin.tabs.highlight.defaultTitle"
msgstr "Highlight"

msgid "plugins.generic.rankingPlugin.tabs.highlight.content.videoDescription"
msgstr "Launched in 1961, RAE supported the development of administrative thinking in Brazil and the consolidation of the profession of administrator."

msgid "plugins.generic.rankingPlugin.tabs.mostRecent.defaultTitle"
msgstr "Most recent"

msgid "plugins.generic.rankingPlugin.tabs.mostRecent.content.description"
msgstr "Articles most recently published for this journal."

msgid "plugins.generic.rankingPlugin.tabs.mostRead.defaultTitle"
msgstr "Most read"

msgid "plugins.generic.rankingPlugin.tabs.mostRead.content.description"
msgstr "Most read articles in this journal in the last six months."

msgid "plugins.generic.rankingPlugin.tabs.mostCited.defaultTitle"
msgstr "Most cited"

msgid "plugins.generic.rankingPlugin.tabs.mostCited.content.description"
msgstr "Most cited articles published in this journal. These statistics are updated monthly using data sourced exclusively from <a href="https://www.crossref.org/services/cited-by/" target="_blank">CrossRef</a>"

msgid "plugins.generic.rankingPlugin.tabs.mostCitedFailed"
msgstr "Error when trying to find the most cited submissions."

msgid "plugins.generic.rankingPlugin.tabs.trending.defaultTitle"
msgstr "Trending"

msgid "plugins.generic.rankingPlugin.tabs.trending.content.description"
msgstr "Articles with the highest Altmetrics score, indicating influence and impact."

msgid "plugins.generic.rankingPlugin.tabs.trendingFailed"
msgstr "Error when trying to find the trending submissions."

msgid "plugins.generic.rankingPlugin.tabs.content.publishedDate"
msgstr "Published: {$datePublished}"

msgid "plugins.generic.rankingPlugin.loading"
msgstr "Loading articles..."

msgid "plugins.generic.rankingPlugin.NoPublicationsFound"
msgstr "No publications found."

msgid "plugins.generic.rankingPlugin.client.crossref.serverError"
msgstr "Error while trying to retrieve the most cited publications. The Crossref API returned an internal error."

msgid "plugins.generic.rankingPlugin.client.crossref.clientError"
msgstr "Error while trying to retrieve the most cited publications. The Crossref API returned a client error."

msgid "plugins.generic.rankingPlugin.client.crossref.transferError"
msgstr "Error while trying to retrieve the most cited publications. The Crossref API returned a transfer error."

msgid "plugins.generic.rankingPlugin.client.altmetrics.serverError"
msgstr "Error while trying to retrieve the Altmetrics Score. The Altmetrics API returned an internal error."

msgid "plugins.generic.rankingPlugin.client.altmetrics.clientError"
msgstr "Error while trying to retrieve the Altmetrics Score. The Altmetrics API returned a client error."

msgid "plugins.generic.rankingPlugin.client.altmetrics.transferError"
msgstr "Error while trying to retrieve the Altmetrics Score. The Altmetrics API returned a transfer error."
