msgid "plugins.generic.rankingPlugin.settings.displayPosition"
msgstr "Position on the journal homepage"

msgid "plugins.generic.rankingPlugin.settings.displayPosition.description"
msgstr "Choose where the ranking block is rendered on the journal homepage."

msgid "plugins.generic.rankingPlugin.settings.displayPosition.additionalContent"
msgstr "Where the &lt;div class=&quot;rankingTabs&quot;&gt;&lt;/div&gt; element is placed in Additional Content"

msgid "plugins.generic.rankingPlugin.settings.displayPosition.top"
msgstr "At the top of the homepage, before all other content"

msgid "plugins.generic.rankingPlugin.settings.displayPosition.afterSection"
msgstr "After a given section of the homepage"

msgid "plugins.generic.rankingPlugin.settings.displayPosition.bottom"
msgstr "At the bottom of the homepage, after all other content"

msgid "plugins.generic.rankingPlugin.settings.displayPositionSection"
msgstr "After which section?"

msgid "plugins.generic.rankingPlugin.settings.displayPositionSection.description"
msgstr "Use this to place the block in the middle of the homepage, between two sections. Sections are the blocks your theme stacks on the page: usually the journal description, the announcements, the current issue and the additional content. Enter 1 to show the block right after the first section, 2 for after the second, and so on. If the number is higher than the number of sections on the page, the block goes to the bottom."
