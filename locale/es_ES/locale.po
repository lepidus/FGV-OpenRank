msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey"
msgstr "Clave de API de Altmetric"

msgid "plugins.generic.rankingPlugin.settings.altmetricsApiKey.description"
msgstr "Introduzca la clave de API de Altmetric (opcional). Si se deja vacía, la pestaña Trending usará la lista manual de DOIs definida abajo. Requiere 'api_key_secret' configurado en config.inc.php."

